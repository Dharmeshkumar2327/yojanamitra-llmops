# ---------- LLM (Groq, OpenAI-compatible) ----------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_SMALL_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile
# USD per 1M tokens - verify on https://groq.com/pricing
PRICE_INPUT_PER_M=0.59
PRICE_OUTPUT_PER_M=0.79

# ---------- Vector DB (Qdrant) ----------
# Local docker: http://localhost:6333   |  Qdrant Cloud: https://xxxx.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=govt_schemes

# ---------- Embeddings / reranker (fastembed, runs on CPU) ----------
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
RERANK_ENABLED=true
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

# ---------- Retrieval ----------
# hybrid (default) | dense (Week 2 baseline - use to fill the "v1" row of the results table)
RETRIEVAL_MODE=hybrid
TOP_K_PREFETCH=20
TOP_K_FINAL=5
MIN_DENSE_SCORE=0.35

# ---------- Cache ----------
# Leave empty to use the in-memory cache
REDIS_URL=
CACHE_SIMILARITY=0.95
CACHE_TTL_SECONDS=86400

# ---------- Observability (Langfuse) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMPT_NAME=yojanamitra-rag
PROMPT_LABEL=production

# ---------- Request logs (monitoring dashboard) ----------
# Local: sqlite. Production: free Postgres (Neon / Supabase / Render)
DATABASE_URL=sqlite:///data/requests.db

# ---------- API ----------
API_URL=http://localhost:8000
RATE_LIMIT_PER_MIN=30
